  "context_variables": [],
  "noise": 0.0,
  "n_min": 1,
  "p_value": 0.05,
  "mi_query": false,
  "plot_ddtw": false,
  "ht_query": true,
  "ht_query_type": "S",
  "eq_condition": "W",
  "is_aggregation": true,
  "user_json": {
    "case_study": "GREEN",
    "version": "V5-CROSS-COARSE",
    "variables": [
      {
        "name": "Ta",
        "source": "TCuscinettiAlimentazione",
        "role": "estimated",
        "type": "REAL"
      },
      {
        "name": "ab",
        "source": "Assorbimento",
        "role": "driver",
        "type": "REAL"
      },
      {
        "name": "tr",
        "source": "TCuscinettiRiduttore",
        "role": "driver",
        "type": "REAL"
      }
    ],
    "models": [
      {
        "id": 0,
        "name": "Absorption (modello_assorbimento)",
        "type": "MEAN"
      }
    ],
    "events": [
      {
        "symbol": "ab_0",
        "model_id": 0,
        "guard": "(0 <= ab and ab < 100) and not (0 <= prev_ab and prev_ab < 100)"
      },
      {
        "symbol": "ab_1",
        "model_id": 0,
        "guard": "(100 <= ab) and not (100 <= prev_ab)"
      },
      {
        "symbol": "tr_2",
        "model_id": 0,
        "guard": "(0 <= tr and tr < 25) and not (0 <= prev_tr and prev_tr < 25)"
      },
      {
        "symbol": "tr_3",
        "model_id": 0,
        "guard": "(25 <= tr) and not (25 <= prev_tr)"
      },
      {
        "symbol": "s",
        "model_id": 0,
        "guard": ""
      }
    ],
    "constants": {
      "AB_RANGE": 50,
      "TR_RANGE": 20
    },
    "trace_generation": {
      "strategy": "CSV",
      "csv": {
        "wide_or_long": "long",
        "timestamp_column": "time",
        "field_column": "DataObjectField",
        "value_column": "Value",
        "interpolate_method": "linear",
        "bundle_all_csv": true
      },
      "physics_constants": {
        "tolerances": {
          "ab": 100,
          "tr": 25
        }
      }
    }
  }
