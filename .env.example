# --- UPPAAL (runs on the HOST, outside Docker) --------------------------------
# UPPAAL 5.x segfaults inside a container (its licence check dereferences NULL
# when hardware fingerprinting comes up empty — happens even with --privileged
# and full /dev + /sys mounted). So verifyta stays native and the container
# reaches it through ./uppaal-bridge/server.py.
#
# Start the bridge on the host BEFORE running UPPAAL case studies:
#     ./uppaal-bridge/run-bridge.sh
#
# Only needed for UPPAAL case studies (THERMO, HRI); CSV ones ignore all of this.
# Activate the licence once on the host first:  verifyta -k <your-key>
UPPAAL_BIN=/opt/uppaal/lib/app/bin/verifyta
UPPAAL_BRIDGE_PORT=8899
# Shared secret between the bridge and the in-container shim — change this.
UPPAAL_BRIDGE_TOKEN=change-me

# Which Compose profile(s) `docker compose up` activates by default.
# dev  = Vite dev server with hot reload (localhost:5173)
# prod = Nginx serving a static build (localhost:80)
# Override per-run without editing this file: COMPOSE_PROFILES=prod docker compose up
COMPOSE_PROFILES=dev
